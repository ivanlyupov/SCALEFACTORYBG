# =============================================================
# SCALEFACTORYBG — ENVIRONMENT VARIABLES
# Copy this file to ".env" and fill in real values.
# Add these SAME variables in Vercel: Project → Settings →
# Environment Variables (do NOT commit your real .env to GitHub).
# =============================================================

# From Supabase: Project Settings → Data API  (the "Project URL")
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# From Supabase: Project Settings → API Keys → "service_role" secret key.
# SERVER-ONLY. Never put this in front-end code or a VITE_ / public var.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
