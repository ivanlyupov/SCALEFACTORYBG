# =============================================================
# SCALEFACTORYBG — ENVIRONMENT VARIABLES
# Copy this file to ".env" and fill in real values.
# Add these SAME variables in Vercel: Project → Settings →
# Environment Variables (do NOT commit your real .env to GitHub).
# =============================================================

# From Supabase: Project Settings → Data API  (the "Project URL")
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# From Supabase: Project Settings → API Keys → the "Secret key" (sb_secret_...).
# SERVER-ONLY. Never put this in front-end code or a VITE_ / public var.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Password for the private leads dashboard at /admin.
# Pick anything long and hard to guess. SERVER-ONLY (checked on the server).
ADMIN_PASSWORD=choose-a-long-random-password
